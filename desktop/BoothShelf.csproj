<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BOOTH-Shelf</AssemblyName>
    <RootNamespace>BoothShelf</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>8.0.33</RuntimeFrameworkVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="FeatureDiagnostics.cs;BoothDiagnostics.cs" />
    <EmbeddedResource Include="..\filter-presets.js;..\notifications.js;..\app-updates.js"><LogicalName>Assets.%(Filename)%(Extension)</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="app.ico"><LogicalName>Assets.app.ico</LogicalName></EmbeddedResource>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <EmbeddedResource Include="..\index.html;..\styles.css;..\app.js;..\parser.js;..\page-reader.js;..\library-filters.js;..\account-reader.js;..\features.js;..\i18n.js;..\locales.json">
      <LogicalName>Assets.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
